bin/
cover.out
*-docs/

# kubebuilder helm plugin's intermediate output (dist/install.yaml, dist/chart/)
# — regenerated by `make build-installer` / `kubebuilder edit --plugins=helm/v2-alpha`
# every time; database/charts/ is the real, hand-maintained chart, not this.
dist/

# packaged chart archives (helm package output) — never committed, only published
*.tgz

# Local experiment Addon manifest — points at a personal GHCR
# namespace, not the real org registry. A real, scrubbed manifest belongs at
# this same path eventually ; this ignore rule must be removed when
# that real version is ready to commit, not bypassed with a force-add.
deploy/harvester-addon/dbaas-operator/dbaas-operator.yaml

